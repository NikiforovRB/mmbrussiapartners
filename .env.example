# ─────────────────────────────────────────────────────────────
# АТОЛ Онлайн — облачная касса (фискализация чеков по 54-ФЗ).
# ВАЖНО: логин/пароль здесь — НЕ от личного кабинета newonline.atol.ru,
# а из «файла настроек интеграции» (ЛК → Настройки → Интеграция).
# Там же берётся код группы ККТ (group_code).
# Версия протокола в ATOL_BASE_URL должна совпадать с той, на которую
# зарегистрирован код группы, иначе getToken отдаёт ошибку 21.
# Тестовый контур: https://testonline.atol.ru/possystem/v4
# ─────────────────────────────────────────────────────────────
ATOL_LOGIN=""
ATOL_PASSWORD=""
ATOL_GROUP=""
ATOL_BASE_URL="https://online.atol.ru/possystem/v4"

# Реквизиты продавца для чека
ATOL_COMPANY_INN=""
ATOL_COMPANY_EMAIL="marat@mmbrussia.ru"
ATOL_COMPANY_PAYMENT_ADDRESS="https://mmbrussia.ru"
# osn | usn_income | usn_income_outcome | envd | esn | patent
ATOL_COMPANY_SNO="usn_income"
# none | vat0 | vat10 | vat20 | vat22 | vat110 | vat120 | vat122
ATOL_VAT_TYPE="none"

# Колбэк АТОЛ приходит без подписи, поэтому подлинность подтверждает
# неугадываемый токен в самом адресе callback_url. Задайте случайную
# строку (например `openssl rand -hex 32`). Пока переменная пуста,
# колбэк не запрашивается, а статус чека подтягивается опросом кассы.
ATOL_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────────────────────
# Приём платежей (эквайринг). АТОЛ Онлайн деньги НЕ принимает —
# это отдельный продукт АТОЛ Pay либо банковский интернет-эквайринг.
# manual   — счёт на оплату, статус подтверждает администратор
# atol_pay — платёжные ссылки АТОЛ Pay (нужен API-токен из ЛК АТОЛ Pay)
# ─────────────────────────────────────────────────────────────
PAYMENT_PROVIDER="manual"
PAYMENT_LICENSE_PRICE="15000"
ATOL_PAY_BASE_URL="https://api.pay.atol.ru"
ATOL_PAY_API_TOKEN=""

LICENSE_API_URL=""
LICENSE_API_KEY=""

