DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# Адрес кабинета целиком, со схемой. На проде обязательно https: по схеме
# выбирается имя cookie сессии, и http за https-прокси разлогинит всех.
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

S3_ENDPOINT="https://s3.twcstorage.ru"
S3_REGION="ru-1"
S3_BUCKET="mmbrussia-baket"
S3_ACCESS_KEY="your-s3-access-key"
S3_SECRET_KEY="your-s3-secret-key"
S3_PREFIX="partners-portal/"

# SMTP — отправка писем, включая фискальный чек дилеру после оплаты.
# Порт 465 → SSL, 587 → STARTTLS. Пока не заполнено — письма не отправляются
# (чек всё равно уходит через ОФД на email, указанный в самом чеке).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="MMB RUSSIA <noreply@mmbrussia.ru>"

# ─────────────────────────────────────────────────────────────
# АТОЛ Онлайн — облачная касса (фискализация чеков по 54-ФЗ).
# ВАЖНО: логин/пароль здесь — НЕ от личного кабинета newonline.atol.ru,
# а из «файла настроек интеграции» (ЛК → Настройки → Интеграция).
# Там же берётся код группы ККТ (group_code).
# Версия протокола в ATOL_BASE_URL должна совпадать с той, на которую
# зарегистрирован код группы, иначе getToken отдаёт ошибку 21.
# Тестовый контур: https://testonline.atol.ru/possystem/v4
# ─────────────────────────────────────────────────────────────
ATOL_LOGIN=""
ATOL_PASSWORD=""
ATOL_GROUP=""
ATOL_BASE_URL="https://online.atol.ru/possystem/v4"

# Реквизиты продавца для чека
ATOL_COMPANY_INN=""
ATOL_COMPANY_EMAIL="marat@mmbrussia.ru"
ATOL_COMPANY_PAYMENT_ADDRESS="https://mmbrussia.ru"
# osn | usn_income | usn_income_outcome | envd | esn | patent
ATOL_COMPANY_SNO="usn_income"
# Ставка НДС и наименование услуги задаются в админке: Настройки → Настройки
# онлайн-оплаты (по умолчанию НДС 5% и «Услуга по модификации ПО»).
# Переменная ниже — только фолбэк, если настройка в БД ещё не сохранена.
# none | vat0 | vat5 | vat7 | vat10 | vat20
ATOL_VAT_TYPE="vat5"

# Колбэк АТОЛ приходит без подписи, поэтому подлинность подтверждает
# неугадываемый токен в самом адресе callback_url. Задайте случайную
# строку (например `openssl rand -hex 32`). Пока переменная пуста,
# колбэк не запрашивается, а статус чека подтягивается опросом кассы.
ATOL_WEBHOOK_SECRET=""

# ─────────────────────────────────────────────────────────────
# Приём платежей (эквайринг). АТОЛ Онлайн деньги НЕ принимает —
# это отдельный продукт АТОЛ Pay либо банковский интернет-эквайринг.
# manual   — счёт на оплату, статус подтверждает администратор
# atol_pay — АТОЛ Pay Ecom (интернет-эквайринг): дилер попадает на платёжную
#            форму. Требует токен из ЛК АТОЛ Pay (https://lk.atolpay.ru/).
# ─────────────────────────────────────────────────────────────
PAYMENT_PROVIDER="manual"
# Цены ведутся в админке («Справочник цен»). Переменные ниже — запасной
# вариант для позиций, которых в справочнике ещё нет.
PAYMENT_BUNDLE_PRICES='{"FULL":10000,"ECO":6000}'
PAYMENT_LICENSE_PRICE="15000"
# Боевой контур АТОЛ Pay Ecom. Тест: https://croc-sandbox-api-mobile.atolpay.ru/v1/ecom
ATOL_PAY_BASE_URL="https://new-api-mobile.atolpay.ru/v1/ecom"
# ЛК АТОЛ Pay → Настройки → API Токены (передаётся как Authorization: Bearer).
ATOL_PAY_API_TOKEN=""
# Способы оплаты на форме в виде тип:банк через запятую, например
# "card:700,bank_app:700,sbp:600" (карта и T-Pay через Т-Банк, СБП через ЮКассу).
# Пусто — берутся из ЛК АТОЛ Pay (Настройки → Настройки заказов); если не заданы
# и там, АТОЛ Pay не создаст заказ.
ATOL_PAY_PAYMENT_METHODS=""
# Токен в адресе callback АТОЛ Pay (по умолчанию берётся ATOL_WEBHOOK_SECRET).
ATOL_PAY_WEBHOOK_SECRET=""

LICENSE_API_URL=""
LICENSE_API_KEY=""

# DRIVEMODS Store API (генерация лицензий через ШГУ)
# Мастер-аккаунт DriveMods, от имени которого работает весь портал.
# Имя субдилера передаётся в поле dealer_comment при каждой генерации.
DRIVEMODS_STORE_API_URL="https://storeapi.drivemods.org"
DRIVEMODS_CLIENT_TOKEN=""
DRIVEMODS_USERNAME=""
DRIVEMODS_PASSWORD=""

# Провайдер IP-геолокации для фиксации «родительского» гео при регистрации
GEO_LOOKUP_URL="http://ip-api.com/json"

PUBLIC_SITE_ORIGIN="https://mmbrussia.ru"

# Публичный адрес кабинета: сюда уводим браузер после выхода из профиля,
# чтобы в разработке не оставаться на localhost.
NEXT_PUBLIC_CABINET_URL="https://cabinet.mmbrussia.ru"

# Фоновая анимация первого экрана главной (false — откат к статичному фону)
NEXT_PUBLIC_HERO_ANIMATED_BG="true"
COMPANY_PHONE="8 (925) 037-46-66"
COMPANY_EMAIL="marat@mmbrussia.ru"

ADMIN_NOTIFY_EMAIL="marat@mmbrussia.ru"
