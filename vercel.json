{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run vercel-build",
  "framework": "nextjs",
  "regions": ["fra1"],
  "crons": [
    {
      "path": "/api/cron/license-expiry",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/expire-licenses",
      "schedule": "30 0 * * *"
    }
  ]
}
