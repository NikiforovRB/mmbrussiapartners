generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum LicenseStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
  REVOKED
}

enum LicenseAction {
  CREATED
  EDITED
  CANCELLED
  REVOKED
  DELETED
  RESTORED
  EXPIRED
}

enum NotificationChannel {
  EMAIL
  TELEGRAM
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum CancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  status          UserStatus @default(PENDING)
  isSuperAdmin    Boolean    @default(false)
  twoFactorSecret String?
  twoFactorEnabled Boolean   @default(false)
  notifyByEmail   Boolean    @default(true)
  notifyByTelegram Boolean   @default(false)
  telegramChatId  String?
  lastLoginAt     DateTime?
  lastLoginIp     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  dealerProfile         DealerProfile?
  licenses              License[]      @relation("DealerLicenses")
  auditedActions        LicenseAuditLog[] @relation("AuditActor")
  approvedDealers       DealerProfile[]   @relation("ApprovedBy")
  payments              Payment[]
  confirmedPayments     Payment[]      @relation("ConfirmedPayments")
  uploadedFiles         FileObject[]
  notifications         NotificationLog[]
  sessions              Session[]
  requestedCancellations CancellationRequest[] @relation("RequestedCancellations")
  reviewedCancellations  CancellationRequest[] @relation("ReviewedCancellations")

  @@index([status])
  @@index([roleId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model DealerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  firstName           String
  lastName            String
  middleName          String?
  organization        String?
  inn                 String?
  phone               String
  phoneVisibleOnSite  Boolean  @default(false)
  city                String?
  region              String?
  address             String?
  lat                 Float?
  lng                 Float?
  avatarKey           String?
  signupCountry       String?
  signupCity          String?
  signupIp            String?
  licenseLimit        Int      @default(0)
  licensesUsed        Int      @default(0)
  approvedAt          DateTime?
  approvedById        String?
  rejectionReason     String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy  User? @relation("ApprovedBy", fields: [approvedById], references: [id])

  @@index([region])
  @@index([city])
  @@index([phoneVisibleOnSite])
}

model License {
  id                    String        @id @default(cuid())
  number                String        @unique
  dealerId              String
  type                  String        @default("Генерация")
  status                LicenseStatus @default(DRAFT)
  features              Json          @default("{}")
  termStart             DateTime
  termEnd               DateTime
  deviceId              String
  deviceIdKey           String?
  licenseKey            String?
  product               String?
  bundle                String?
  productRegion         String?
  versionSoftware       String?
  versionCustom         String?
  dealerComment         String?
  customerFio           String
  customerOrganization  String?
  customerEmail         String?
  customerPhone         String?
  city                  String?
  region                String?
  vehicleVin            String?
  vehicleModel          String?
  platform              String?
  issuedWithoutPayment  Boolean       @default(false)
  price                 Decimal?      @db.Decimal(12, 2)
  cancelledAt           DateTime?
  cancellationReason    String?
  deletedAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  dealer               User                  @relation("DealerLicenses", fields: [dealerId], references: [id])
  payment              Payment?              @relation("LicensePayment")
  auditLogs            LicenseAuditLog[]
  cancellationRequests CancellationRequest[]

  @@index([dealerId])
  @@index([status])
  @@index([termEnd])
  @@index([customerEmail])
  @@index([customerPhone])
  @@index([region])
  @@index([deletedAt])
}

model LicenseAuditLog {
  id        String        @id @default(cuid())
  licenseId String
  actorId   String
  action    LicenseAction
  reason    String?
  diff      Json?
  createdAt DateTime      @default(now())

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  actor   User    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([licenseId])
  @@index([actorId])
  @@index([action])
}

model Payment {
  id             String        @id @default(cuid())
  dealerId       String
  licenseId      String?       @unique
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("RUB")
  status         PaymentStatus @default(PENDING)
  provider       String        @default("manual")
  externalId     String?
  payUrl         String?
  providerPayload Json?
  description    String?
  paidAt         DateTime?
  confirmedById  String?

  // Фискализация чека в АТОЛ Онлайн (54-ФЗ)
  receiptUuid      String?
  receiptStatus    String?
  receiptUrl       String?
  fiscalDocNumber  String?
  receiptError     String?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  dealer      User     @relation(fields: [dealerId], references: [id])
  license     License? @relation("LicensePayment", fields: [licenseId], references: [id])
  confirmedBy User?    @relation("ConfirmedPayments", fields: [confirmedById], references: [id])

  @@index([dealerId])
  @@index([status])
  @@index([receiptStatus])
}

model CancellationRequest {
  id            String                    @id @default(cuid())
  licenseId     String
  requestedById String
  reason        String
  status        CancellationRequestStatus @default(PENDING)
  reviewedById  String?
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  license     License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("RequestedCancellations", fields: [requestedById], references: [id])
  reviewedBy  User?   @relation("ReviewedCancellations", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([licenseId])
  @@index([requestedById])
}

model NotificationLog {
  id        String              @id @default(cuid())
  userId    String?
  channel   NotificationChannel
  recipient String
  subject   String?
  body      String
  status    NotificationStatus  @default(QUEUED)
  error     String?
  createdAt DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@index([channel])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  html      String
  variables Json     @default("[]")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

model CompanySettings {
  id           String  @id @default(cuid())
  phone        String
  email        String
  address      String?
  publicPhones Json    @default("[]")
  homepage     Json?
  updatedAt    DateTime @updatedAt
}

model FileObject {
  id          String   @id @default(cuid())
  key         String   @unique
  bucket      String
  contentType String?
  size        Int?
  uploaderId  String?
  purpose     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  uploader User? @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([uploaderId])
  @@index([purpose])
}

model SavedFilter {
  id        String   @id @default(cuid())
  ownerId   String
  scope     String
  name      String
  query     Json
  createdAt DateTime @default(now())

  @@index([ownerId, scope])
}
