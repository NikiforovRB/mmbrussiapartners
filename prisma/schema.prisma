generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum LicenseStatus {
  ACTIVE
  CANCELLED
}

enum LicenseAction {
  CREATED
  EDITED
  CANCELLED
  REVOKED
  DELETED
  RESTORED
  EXPIRED
}

enum NotificationChannel {
  EMAIL
  TELEGRAM
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

/** Тип события в колокольчике кабинета. */
enum AppNotificationType {
  DEALER_REGISTERED
  DEALER_APPROVED
  DEALER_REJECTED
  DEALER_SUSPENDED
  LICENSE_ISSUED
  LICENSE_CANCELLED
  LICENSE_REVOKED
  CANCELLATION_REQUESTED
  CANCELLATION_REVIEWED
  PAYMENT_CREATED
  PAYMENT_PAID
  PAYMENT_REFUNDED
  RECEIPT_FAILED
  PRICE_MISSING
  SITE_PUBLICATION_REQUESTED
  SITE_PUBLICATION_REVIEWED
}

/** Область, к которой относится действие в журнале аудита. */
enum AuditEntity {
  DEALER
  ROLE
  PAYMENT
  SETTINGS
  PRICE
}

/// Как считать цены представителя относительно справочника.
enum PriceAdjustKind {
  /// Цены справочника без изменений.
  NONE
  /// Процент к каждой цене: 10 — дороже на 10%, -10 — дешевле.
  PERCENT
  /// Фиксированная сумма в рублях к каждой цене, может быть отрицательной.
  FIXED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum CancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  /// Пароль представителя, зашифрованный ключом DEALER_PASSWORD_KEY из
  /// окружения сервера (AES-256-GCM): его видит администратор с правом
  /// dealers.passwords. У сотрудников всегда null.
  passwordEncrypted String?
  status          UserStatus @default(PENDING)
  isSuperAdmin    Boolean    @default(false)
  twoFactorSecret String?
  twoFactorEnabled Boolean   @default(false)
  notifyByEmail   Boolean    @default(true)
  notifyByTelegram Boolean   @default(false)
  telegramChatId  String?
  lastLoginAt     DateTime?
  lastLoginIp     String?
  /// Увеличение отзывает все выданные JWT-сессии (смена пароля, блокировка).
  sessionVersion  Int        @default(0)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  dealerProfile         DealerProfile?
  licenses              License[]      @relation("DealerLicenses")
  auditedActions        LicenseAuditLog[] @relation("AuditActor")
  approvedDealers       DealerProfile[]   @relation("ApprovedBy")
  payments              Payment[]
  confirmedPayments     Payment[]      @relation("ConfirmedPayments")
  uploadedFiles         FileObject[]
  notifications         NotificationLog[]
  appNotifications      AppNotification[]
  adminAuditActions     AdminAuditLog[]  @relation("AdminAuditActor")
  sessions              Session[]
  requestedCancellations CancellationRequest[] @relation("RequestedCancellations")
  reviewedCancellations  CancellationRequest[] @relation("ReviewedCancellations")
  prices                 DealerPrice[]         @relation("DealerPrices")
  humaxPasswords         HumaxPassword[]       @relation("DealerHumaxPasswords")
  loginNoticeAcks        LoginNoticeAck[]
  ips                    UserIp[]
  legacyDealer           LegacyDealer?         @relation("LegacyDealerLink")

  @@index([status])
  @@index([roleId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// IP-адреса, с которых пользователь заходил в кабинет. Страна и город
/// определяются по адресу один раз, при первом появлении.
model UserIp {
  id          String   @id @default(cuid())
  userId      String
  ip          String
  country     String?
  countryCode String?
  city        String?
  /// Сколько раз адрес отметился (не чаще раза в несколько минут).
  hits        Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ip])
  @@index([userId, lastSeenAt])
  @@index([ip])
}

/// Представитель из старого ЛК DriveMods (store.drivemods.ru) со статистикой
/// выдач. account — своя учётка субдилера в ЛК; comment — лицензии, которые
/// выписывали за него из общего кабинета, с именем и городом в комментарии.
model LegacyDealer {
  id             String    @id @default(cuid())
  source         String
  /// objectId учётки ЛК либо нормализованные «имя город» из комментария.
  externalKey    String    @unique
  name           String
  email          String?
  phone          String?
  city           String?
  country        String?
  registeredAt   DateTime?
  active         Boolean   @default(true)
  licenses       Int       @default(0)
  /// Выписаны самим субдилером в своей учётке.
  viaAccount     Int       @default(0)
  /// Выписаны из общего кабинета с его именем в комментарии.
  viaComment     Int       @default(0)
  paidLicenses   Int       @default(0)
  unpaidLicenses Int       @default(0)
  amountTotal    Decimal   @default(0) @db.Decimal(14, 2)
  amountPaid     Decimal   @default(0) @db.Decimal(14, 2)
  amountUnpaid   Decimal   @default(0) @db.Decimal(14, 2)
  firstLicenseAt DateTime?
  lastLicenseAt  DateTime?
  /// Пополнения баланса в учётке ЛК (записи «Оплата» и «Внешняя оплата»).
  payments       Int       @default(0)
  paymentsAmount Decimal   @default(0) @db.Decimal(14, 2)
  /// [{ position, count, amount }] по убыванию count.
  products       Json      @default("[]")
  /// Несколько исходных комментариев — чтобы сверить, о ком речь.
  comments       Json      @default("[]")
  /// Учётка портала, к которой привязан (по email/телефону или вручную).
  userId         String?   @unique
  importedAt     DateTime  @default(now())

  user User? @relation("LegacyDealerLink", fields: [userId], references: [id], onDelete: SetNull)

  @@index([source])
  @@index([email])
  @@index([phone])
}

model DealerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  firstName           String
  lastName            String
  middleName          String?
  organization        String?
  inn                 String?
  phone               String
  phoneVisibleOnSite  Boolean  @default(false)
  city                String?
  region              String?
  address             String?
  lat                 Float?
  lng                 Float?
  avatarKey           String?
  signupCountry       String?
  signupCity          String?
  signupIp            String?
  licenseLimit        Int      @default(0)
  licensesUsed        Int      @default(0)
  /// Есть ли у представителя доступ к личному кабинету DriveMods (видно
  /// только администраторам). Часть типов лицензий выдаётся только там.
  driveModsAccess      Boolean  @default(false)
  /// Когда представитель отправил заявку на подключение к ЛК DriveMods.
  driveModsRequestedAt DateTime?
  /// Общее правило пересчёта цен справочника для этого представителя.
  priceAdjustKind     PriceAdjustKind @default(NONE)
  priceAdjustValue    Decimal? @db.Decimal(12, 2)
  /// Ценовой тариф представителя: DEALER — по дилерской цене (обычный),
  /// CLIENT — по клиентской (субдилеры/реселлеры, «своя цена»).
  priceTier           String   @default("DEALER")
  /// Предоплатный расчёт: до генерации нужно погасить неоплаченные счета.
  /// Доверенным представителям оставляют postpaid (false) — генерируют сразу.
  prepaid             Boolean  @default(false)
  /// Работал с нами в старом ЛК DriveMods: первая генерация позиции идёт по
  /// дилерской цене, а не по клиентской, как у новичков.
  legacyDealer        Boolean  @default(false)
  approvedAt          DateTime?
  approvedById        String?
  rejectionReason     String?
  notes               String?
  /// Страна для «Дилерской сети» на mmbrussia.ru (города там сгруппированы
  /// по странам). Пусто — отправляется «Россия».
  country             String?
  /// Подпись к телефону в «Дилерской сети»: имя, район и т.п.
  siteComment         String?
  /// Модерация публикации телефона. На сайте телефон только при
  /// phoneVisibleOnSite (согласие представителя) + APPROVED + активной учётке.
  sitePublication     SitePublicationStatus @default(NONE)
  /// Когда подана заявка или изменён её статус.
  sitePublicationAt   DateTime?
  sitePublicationById String?
  /// Причина отклонения или снятия с сайта — её видит представитель.
  sitePublicationNote String?
  /// По последнему успешному ответу сайта запись есть в «Дилерской сети».
  siteListed          Boolean  @default(false)
  siteSyncedAt        DateTime?
  /// Статус из ответа сайта: created, linked, updated, unchanged, removed,
  /// conflict, error — либо failed, если сайт не ответил.
  siteSyncStatus      String?
  siteSyncMessage     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy  User? @relation("ApprovedBy", fields: [approvedById], references: [id])

  @@index([region])
  @@index([city])
  @@index([phoneVisibleOnSite])
  @@index([sitePublication])
}

enum SitePublicationStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

/**
 * Обмены с «Дилерской сетью» mmbrussia.ru: каждое событие (upsert/remove) и
 * каждая полная сверка (sync). Последняя сверка показывается в настройках.
 */
model SiteSyncLog {
  id         String   @id @default(cuid())
  /// upsert | remove | sync
  action     String
  /// Что вызвало обмен: profile, publication, status, delete, daily, manual, retry.
  trigger    String
  dryRun     Boolean  @default(false)
  ok         Boolean
  httpStatus Int?
  /// Сколько представителей было в запросе.
  dealers    Int      @default(0)
  summary    Json?
  warnings   Json?
  /// Только проблемные строки ответа (conflict, error).
  problems   Json?
  error      String?
  actorId    String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, dryRun, createdAt])
}

model License {
  id                    String        @id @default(cuid())
  number                String        @unique
  dealerId              String
  type                  String        @default("Генерация")
  status                LicenseStatus @default(ACTIVE)
  features              Json          @default("{}")
  deviceId              String
  deviceIdKey           String?
  licenseKey            String?
  product               String?
  bundle                String?
  productRegion         String?
  versionSoftware       String?
  versionCustom         String?
  dealerComment         String?
  /// Город и регион представителя на момент выдачи: по ним строится
  /// гео-аналитика, и переезд дилера не должен переписывать прошлое.
  city                  String?
  region                String?
  issuedWithoutPayment  Boolean       @default(false)
  /// Для этого ШГУ лицензия уже выдавалась: DRIVEMODS вернул recoverable
  /// либо генерация по такому device_id уже была у нас.
  repeatGeneration      Boolean       @default(false)
  price                 Decimal?      @db.Decimal(12, 2)
  /// Базовая цена позиции (себестоимость из справочника) на момент выдачи.
  /// Видна только администраторам.
  basePrice             Decimal?      @db.Decimal(12, 2)
  cancelledAt           DateTime?
  cancellationReason    String?
  deletedAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  dealer               User                  @relation("DealerLicenses", fields: [dealerId], references: [id])
  payment              Payment?              @relation("LicensePayment")
  auditLogs            LicenseAuditLog[]
  cancellationRequests CancellationRequest[]

  @@index([dealerId])
  @@index([status])
  @@index([region])
  @@index([deletedAt])
  // Списки лицензий всегда сортируются по createdAt: в админке в пределах
  // «не удалённых», в кабинете дилера — в пределах своего dealerId.
  @@index([deletedAt, createdAt])
  @@index([dealerId, createdAt])
}

model LicenseAuditLog {
  id        String        @id @default(cuid())
  licenseId String
  actorId   String
  action    LicenseAction
  reason    String?
  diff      Json?
  createdAt DateTime      @default(now())

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  actor   User    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([licenseId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([actorId, createdAt])
}

model Payment {
  id             String        @id @default(cuid())
  dealerId       String
  licenseId      String?       @unique
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("RUB")
  status         PaymentStatus @default(PENDING)
  provider       String        @default("manual")
  externalId     String?
  payUrl         String?
  providerPayload Json?
  description    String?
  /// Email получателя фискального чека (тег 1008). Задаётся при выставлении
  /// счёта; по умолчанию — почта представителя. Именно на него ОФД и портал
  /// отправляют чек об оплате.
  receiptEmail   String?
  paidAt         DateTime?
  confirmedById  String?

  // Фискализация чека в АТОЛ Онлайн (54-ФЗ)
  receiptUuid      String?
  receiptStatus    String?
  receiptUrl       String?
  fiscalDocNumber  String?
  receiptError     String?
  /**
   * Номер попытки пробития. Входит в external_id, поэтому у повторной
   * отправки после отказа кассы будет новый идентификатор документа,
   * а у параллельных вызовов одной попытки — общий, и АТОЛ отсечёт дубль.
   */
  receiptAttempt   Int           @default(0)

  // Возврат средств и чек «Возврат прихода»
  /// processing | done | fail; null — возврата не было (или отмечен до появления возвратов)
  refundStatus          String?
  /// atol_pay — деньги вернул эквайринг; manual — администратор вернул сам
  refundMethod          String?
  refundError           String?
  refundedAt            DateTime?
  refundReceiptUuid     String?
  refundReceiptStatus   String?
  refundReceiptUrl      String?
  refundFiscalDocNumber String?
  refundReceiptError    String?
  refundReceiptAttempt  Int       @default(0)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  dealer      User     @relation(fields: [dealerId], references: [id])
  license     License? @relation("LicensePayment", fields: [licenseId], references: [id])
  confirmedBy User?    @relation("ConfirmedPayments", fields: [confirmedById], references: [id])

  @@index([dealerId])
  @@index([status])
  @@index([receiptStatus])
  @@index([createdAt])
  @@index([dealerId, createdAt])
}

model CancellationRequest {
  id            String                    @id @default(cuid())
  licenseId     String
  requestedById String
  reason        String
  status        CancellationRequestStatus @default(PENDING)
  reviewedById  String?
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  license     License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("RequestedCancellations", fields: [requestedById], references: [id])
  reviewedBy  User?   @relation("ReviewedCancellations", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([licenseId])
  @@index([requestedById])
  @@index([status, createdAt])
}

model NotificationLog {
  id        String              @id @default(cuid())
  userId    String?
  channel   NotificationChannel
  recipient String
  subject   String?
  body      String
  status    NotificationStatus  @default(QUEUED)
  error     String?
  createdAt DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@index([channel])
}

/**
 * Событие для колокольчика в кабинете.
 *
 * Отдельно от NotificationLog: тот хранит попытки доставки писем и телеграма,
 * а здесь лежит то, что пользователь видит внутри портала, вместе с признаком
 * прочтения.
 */
model AppNotification {
  id        String              @id @default(cuid())
  userId    String
  type      AppNotificationType
  title     String
  body      String?
  /** Куда вести по клику, например /admin/dealers/<id>. */
  link      String?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/**
 * Счётчики rate-limit («фиксированное окно»), общие для всех инстансов и
 * переживающие рестарт. Пишутся атомарным upsert в src/lib/rate-limit.ts.
 */
model RateLimitBucket {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime @db.Timestamptz(3)

  @@index([resetAt])
}

/**
 * Уведомление, которое показывается пользователю при входе и требует явного
 * подтверждения «Ознакомился». Пока пользователь не подтвердил активное
 * уведомление, окно нельзя закрыть обычным способом.
 */
model LoginNotice {
  id         String   @id @default(cuid())
  title      String
  body       String
  active     Boolean  @default(true)
  requireAck Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  acknowledgements LoginNoticeAck[]

  @@index([active])
}

/**
 * Статья базы знаний. Контент хранится структурированными блоками (blocks),
 * а не сырым HTML: так безопаснее рендерить и проще редактировать.
 */
model KnowledgeArticle {
  id         String   @id @default(cuid())
  title      String
  slug       String   @unique
  categoryId String?
  excerpt    String?
  coverKey   String?
  blocks     Json     @default("[]")
  published  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category KnowledgeCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([published, createdAt])
  @@index([categoryId])
}

/**
 * Категория базы знаний. Вложенность ровно в два уровня: категория
 * (parentId = null) и её подкатегории. Удаление категории убирает и
 * подкатегории, а статьи из них остаются без категории.
 */
model KnowledgeCategory {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent   KnowledgeCategory?  @relation("KnowledgeCategoryTree", fields: [parentId], references: [id], onDelete: Cascade)
  children KnowledgeCategory[] @relation("KnowledgeCategoryTree")
  articles KnowledgeArticle[]

  @@index([parentId, sortOrder])
}

/** Факт ознакомления пользователя с конкретным уведомлением входа. */
model LoginNoticeAck {
  id        String   @id @default(cuid())
  noticeId  String
  userId    String
  createdAt DateTime @default(now())

  notice LoginNotice @relation(fields: [noticeId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([noticeId, userId])
  @@index([userId])
}

/**
 * Журнал действий администратора вне карточки лицензии: представители,
 * роли, платежи, настройки. По лицензиям история пишется в LicenseAuditLog.
 */
model AdminAuditLog {
  id         String      @id @default(cuid())
  actorId    String
  entity     AuditEntity
  entityId   String
  action     String
  summary    String?
  diff       Json?
  createdAt  DateTime    @default(now())

  actor User @relation("AdminAuditActor", fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  html      String
  variables Json     @default("[]")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/**
 * Справочник цен. DRIVEMODS цен не отдаёт: его API возвращает только продукт,
 * пакет и регион, поэтому прайс ведём у себя.
 *
 * Пакет и регион у продукта могут отсутствовать. Храним их пустой строкой,
 * а не null: в Postgres два null в уникальном индексе считаются разными,
 * и позиции без пакета можно было бы завести дважды.
 */
model PriceListItem {
  id        String   @id @default(cuid())
  /// Название продукта из DRIVEMODS, например MB-S5WM.
  product   String
  /// Пакет продукта (FULL, ECO). Пусто — у продукта одна цена.
  bundle    String   @default("")
  /// Регион продукта (RUS, CHN). Пусто — цена общая для всех регионов.
  region    String   @default("")
  /// Дилерская цена (базовая, по которой платит представитель).
  price     Decimal  @db.Decimal(12, 2)
  /// Базовая цена (себестоимость) — видна только администраторам, для маржи.
  myPrice     Decimal? @db.Decimal(12, 2)
  /// Клиентская (розничная) цена. По ней идёт первая генерация позиции.
  clientPrice Decimal? @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealerPrices DealerPrice[]

  @@unique([product, bundle, region])
  @@index([product])
}

/// Цена позиции справочника, назначенная конкретному представителю.
model DealerPrice {
  id        String   @id @default(cuid())
  dealerId  String
  itemId    String
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealer User          @relation("DealerPrices", fields: [dealerId], references: [id], onDelete: Cascade)
  item   PriceListItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([dealerId, itemId])
  @@index([dealerId])
}

/// Пароль для ШГУ HUMAX. Генерируется методом /hupass DRIVEMODS по
/// серийному номеру устройства; историю ведём у себя, чтобы её можно
/// было посмотреть и повторно скопировать без обращения к API.
model HumaxPassword {
  id        String   @id @default(cuid())
  dealerId  String
  serial    String
  password  String
  comment   String?
  createdAt DateTime @default(now())

  dealer User @relation("DealerHumaxPasswords", fields: [dealerId], references: [id])

  @@index([dealerId])
  @@index([serial])
  @@index([dealerId, createdAt])
}

model CompanySettings {
  id           String  @id @default(cuid())
  phone        String
  email        String
  address      String?
  publicPhones Json    @default("[]")
  homepage     Json?
  /// Оранжевое объявление под шапкой кабинета: { enabled, text, updatedAt }.
  announcement Json?
  /// Раздел «Техподдержка»: { intro, requirements, channels: [{label,url,icon,iconUrl,iconHoverUrl}] }.
  support      Json?
  /// Ограничения генерации: окно запрета (blackout) и список устаревших версий кастома.
  generation   Json?
  /// Настройки онлайн-оплаты, редактируемые из админки (не секреты):
  /// { serviceLabel, vatType, paymentMethod }. Секреты (токены, логины кассы)
  /// остаются в .env.
  payment      Json?
  updatedAt    DateTime @updatedAt
}

model FileObject {
  id          String   @id @default(cuid())
  key         String   @unique
  bucket      String
  contentType String?
  size        Int?
  uploaderId  String?
  purpose     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  uploader User? @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([uploaderId])
  @@index([purpose])
}

model SavedFilter {
  id        String   @id @default(cuid())
  ownerId   String
  scope     String
  name      String
  query     Json
  createdAt DateTime @default(now())

  @@index([ownerId, scope])
}
