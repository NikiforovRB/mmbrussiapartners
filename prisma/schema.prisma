generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum LicenseStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
  REVOKED
}

enum LicenseAction {
  CREATED
  EDITED
  CANCELLED
  REVOKED
  DELETED
  RESTORED
  EXPIRED
}

enum NotificationChannel {
  EMAIL
  TELEGRAM
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

/** Тип события в колокольчике кабинета. */
enum AppNotificationType {
  DEALER_REGISTERED
  DEALER_APPROVED
  DEALER_REJECTED
  DEALER_SUSPENDED
  LICENSE_ISSUED
  LICENSE_CANCELLED
  LICENSE_REVOKED
  CANCELLATION_REQUESTED
  CANCELLATION_REVIEWED
  PAYMENT_CREATED
  PAYMENT_PAID
  RECEIPT_FAILED
  PRICE_MISSING
}

/** Область, к которой относится действие в журнале аудита. */
enum AuditEntity {
  DEALER
  ROLE
  PAYMENT
  SETTINGS
  PRICE
}

/// Как считать цены представителя относительно справочника.
enum PriceAdjustKind {
  /// Цены справочника без изменений.
  NONE
  /// Процент к каждой цене: 10 — дороже на 10%, -10 — дешевле.
  PERCENT
  /// Фиксированная сумма в рублях к каждой цене, может быть отрицательной.
  FIXED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum CancellationRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  status          UserStatus @default(PENDING)
  isSuperAdmin    Boolean    @default(false)
  twoFactorSecret String?
  twoFactorEnabled Boolean   @default(false)
  notifyByEmail   Boolean    @default(true)
  notifyByTelegram Boolean   @default(false)
  telegramChatId  String?
  lastLoginAt     DateTime?
  lastLoginIp     String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  dealerProfile         DealerProfile?
  licenses              License[]      @relation("DealerLicenses")
  auditedActions        LicenseAuditLog[] @relation("AuditActor")
  approvedDealers       DealerProfile[]   @relation("ApprovedBy")
  payments              Payment[]
  confirmedPayments     Payment[]      @relation("ConfirmedPayments")
  uploadedFiles         FileObject[]
  notifications         NotificationLog[]
  appNotifications      AppNotification[]
  adminAuditActions     AdminAuditLog[]  @relation("AdminAuditActor")
  sessions              Session[]
  requestedCancellations CancellationRequest[] @relation("RequestedCancellations")
  reviewedCancellations  CancellationRequest[] @relation("ReviewedCancellations")
  prices                 DealerPrice[]         @relation("DealerPrices")

  @@index([status])
  @@index([roleId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model DealerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  firstName           String
  lastName            String
  middleName          String?
  organization        String?
  inn                 String?
  phone               String
  phoneVisibleOnSite  Boolean  @default(false)
  city                String?
  region              String?
  address             String?
  lat                 Float?
  lng                 Float?
  avatarKey           String?
  signupCountry       String?
  signupCity          String?
  signupIp            String?
  licenseLimit        Int      @default(0)
  licensesUsed        Int      @default(0)
  /// Общее правило пересчёта цен справочника для этого представителя.
  priceAdjustKind     PriceAdjustKind @default(NONE)
  priceAdjustValue    Decimal? @db.Decimal(12, 2)
  approvedAt          DateTime?
  approvedById        String?
  rejectionReason     String?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user        User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  approvedBy  User? @relation("ApprovedBy", fields: [approvedById], references: [id])

  @@index([region])
  @@index([city])
  @@index([phoneVisibleOnSite])
}

model License {
  id                    String        @id @default(cuid())
  number                String        @unique
  dealerId              String
  type                  String        @default("Генерация")
  status                LicenseStatus @default(DRAFT)
  features              Json          @default("{}")
  deviceId              String
  deviceIdKey           String?
  licenseKey            String?
  product               String?
  bundle                String?
  productRegion         String?
  versionSoftware       String?
  versionCustom         String?
  dealerComment         String?
  /// Город и регион представителя на момент выдачи: по ним строится
  /// гео-аналитика, и переезд дилера не должен переписывать прошлое.
  city                  String?
  region                String?
  issuedWithoutPayment  Boolean       @default(false)
  /// Для этого ШГУ лицензия уже выдавалась: DRIVEMODS вернул recoverable
  /// либо генерация по такому device_id уже была у нас.
  repeatGeneration      Boolean       @default(false)
  price                 Decimal?      @db.Decimal(12, 2)
  cancelledAt           DateTime?
  cancellationReason    String?
  deletedAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  dealer               User                  @relation("DealerLicenses", fields: [dealerId], references: [id])
  payment              Payment?              @relation("LicensePayment")
  auditLogs            LicenseAuditLog[]
  cancellationRequests CancellationRequest[]

  @@index([dealerId])
  @@index([status])
  @@index([region])
  @@index([deletedAt])
  // Списки лицензий всегда сортируются по createdAt: в админке в пределах
  // «не удалённых», в кабинете дилера — в пределах своего dealerId.
  @@index([deletedAt, createdAt])
  @@index([dealerId, createdAt])
}

model LicenseAuditLog {
  id        String        @id @default(cuid())
  licenseId String
  actorId   String
  action    LicenseAction
  reason    String?
  diff      Json?
  createdAt DateTime      @default(now())

  license License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  actor   User    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([licenseId])
  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([actorId, createdAt])
}

model Payment {
  id             String        @id @default(cuid())
  dealerId       String
  licenseId      String?       @unique
  amount         Decimal       @db.Decimal(12, 2)
  currency       String        @default("RUB")
  status         PaymentStatus @default(PENDING)
  provider       String        @default("manual")
  externalId     String?
  payUrl         String?
  providerPayload Json?
  description    String?
  paidAt         DateTime?
  confirmedById  String?

  // Фискализация чека в АТОЛ Онлайн (54-ФЗ)
  receiptUuid      String?
  receiptStatus    String?
  receiptUrl       String?
  fiscalDocNumber  String?
  receiptError     String?
  /**
   * Номер попытки пробития. Входит в external_id, поэтому у повторной
   * отправки после отказа кассы будет новый идентификатор документа,
   * а у параллельных вызовов одной попытки — общий, и АТОЛ отсечёт дубль.
   */
  receiptAttempt   Int           @default(0)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  dealer      User     @relation(fields: [dealerId], references: [id])
  license     License? @relation("LicensePayment", fields: [licenseId], references: [id])
  confirmedBy User?    @relation("ConfirmedPayments", fields: [confirmedById], references: [id])

  @@index([dealerId])
  @@index([status])
  @@index([receiptStatus])
  @@index([createdAt])
  @@index([dealerId, createdAt])
}

model CancellationRequest {
  id            String                    @id @default(cuid())
  licenseId     String
  requestedById String
  reason        String
  status        CancellationRequestStatus @default(PENDING)
  reviewedById  String?
  reviewNote    String?
  reviewedAt    DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  license     License @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("RequestedCancellations", fields: [requestedById], references: [id])
  reviewedBy  User?   @relation("ReviewedCancellations", fields: [reviewedById], references: [id])

  @@index([status])
  @@index([licenseId])
  @@index([requestedById])
  @@index([status, createdAt])
}

model NotificationLog {
  id        String              @id @default(cuid())
  userId    String?
  channel   NotificationChannel
  recipient String
  subject   String?
  body      String
  status    NotificationStatus  @default(QUEUED)
  error     String?
  createdAt DateTime            @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@index([channel])
}

/**
 * Событие для колокольчика в кабинете.
 *
 * Отдельно от NotificationLog: тот хранит попытки доставки писем и телеграма,
 * а здесь лежит то, что пользователь видит внутри портала, вместе с признаком
 * прочтения.
 */
model AppNotification {
  id        String              @id @default(cuid())
  userId    String
  type      AppNotificationType
  title     String
  body      String?
  /** Куда вести по клику, например /admin/dealers/<id>. */
  link      String?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/**
 * Журнал действий администратора вне карточки лицензии: представители,
 * роли, платежи, настройки. По лицензиям история пишется в LicenseAuditLog.
 */
model AdminAuditLog {
  id         String      @id @default(cuid())
  actorId    String
  entity     AuditEntity
  entityId   String
  action     String
  summary    String?
  diff       Json?
  createdAt  DateTime    @default(now())

  actor User @relation("AdminAuditActor", fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String   @unique
  subject   String
  html      String
  variables Json     @default("[]")
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/**
 * Справочник цен. DRIVEMODS цен не отдаёт: его API возвращает только продукт,
 * пакет и регион, поэтому прайс ведём у себя.
 *
 * Пакет и регион у продукта могут отсутствовать. Храним их пустой строкой,
 * а не null: в Postgres два null в уникальном индексе считаются разными,
 * и позиции без пакета можно было бы завести дважды.
 */
model PriceListItem {
  id        String   @id @default(cuid())
  /// Название продукта из DRIVEMODS, например MB-S5WM.
  product   String
  /// Пакет продукта (FULL, ECO). Пусто — у продукта одна цена.
  bundle    String   @default("")
  /// Регион продукта (RUS, CHN). Пусто — цена общая для всех регионов.
  region    String   @default("")
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealerPrices DealerPrice[]

  @@unique([product, bundle, region])
  @@index([product])
}

/// Цена позиции справочника, назначенная конкретному представителю.
model DealerPrice {
  id        String   @id @default(cuid())
  dealerId  String
  itemId    String
  price     Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dealer User          @relation("DealerPrices", fields: [dealerId], references: [id], onDelete: Cascade)
  item   PriceListItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([dealerId, itemId])
  @@index([dealerId])
}

model CompanySettings {
  id           String  @id @default(cuid())
  phone        String
  email        String
  address      String?
  publicPhones Json    @default("[]")
  homepage     Json?
  updatedAt    DateTime @updatedAt
}

model FileObject {
  id          String   @id @default(cuid())
  key         String   @unique
  bucket      String
  contentType String?
  size        Int?
  uploaderId  String?
  purpose     String?
  metadata    Json?
  createdAt   DateTime @default(now())

  uploader User? @relation(fields: [uploaderId], references: [id], onDelete: SetNull)

  @@index([uploaderId])
  @@index([purpose])
}

model SavedFilter {
  id        String   @id @default(cuid())
  ownerId   String
  scope     String
  name      String
  query     Json
  createdAt DateTime @default(now())

  @@index([ownerId, scope])
}
